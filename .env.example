# Blizz server environment variables
PORT=10000
# Keep this secret. NEVER commit the real value to GitHub.
OPENAI_API_KEY=
# Optional model; GPT-5.6 Luna is designed for cost-sensitive, high-volume workloads.
OPENAI_MODEL=gpt-5.6-luna
# Founder control secret. Keep this only in Render environment variables.
FOUNDER_ADMIN_KEY=
# Payment gateway adapter
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
# Optional CORS restriction for production
ALLOWED_ORIGIN=
# Set true only in a private development environment if you want the test coin button.
ENABLE_TEST_MONEY=false
NODE_ENV=production
